{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "device": {
      "description": "Its serial",
      "type": "string"
    },
    "flows": {
      "description": "Those that show says, see below",
      "items": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "description": "Where that step is written, file:line",
            "type": "string"
          },
          "attempts": {
            "description": "Such as 'passed on retry 2' or 'failed 3 times'; empty for one try",
            "type": "string"
          },
          "began": {
            "description": "Its first try, in UTC; empty if it didn't run",
            "type": "string"
          },
          "blame": {
            "description": "Of a flow that failed, whose fault it is, or empty",
            "enum": [
              "test",
              "app",
              "device",
              ""
            ]
          },
          "failures": {
            "description": "One for each try that failed, also of a flow that passed at last",
            "items": {
              "additionalProperties": false,
              "properties": {
                "because": {
                  "description": "What shows that it isn't the test",
                  "type": "string"
                },
                "before": {
                  "description": "The last 3 steps that passed",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "blame": {
                  "description": "Whose fault it is: test, app or device",
                  "enum": [
                    "test",
                    "app",
                    "device"
                  ]
                },
                "calls": {
                  "description": "The last 5 to the mock, and before them those that went wrong in the failure window",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "In UTC",
                        "type": "string"
                      },
                      "body": {
                        "description": "Only in a requests.json",
                        "type": "string"
                      },
                      "mapping": {
                        "description": "The one that answered: its name, or method and address, and file#n where it is written; empty if none",
                        "type": "string"
                      },
                      "method": {
                        "description": "",
                        "type": "string"
                      },
                      "mocked": {
                        "description": "Whether a mock fitted",
                        "type": "boolean"
                      },
                      "outcome": {
                        "description": "The status, or what happened",
                        "type": "string"
                      },
                      "scenario": {
                        "description": "Of a mapping with a scenario, its state before and after, such as 'booking: 20 -> 21'; empty if none",
                        "type": "string"
                      },
                      "uri": {
                        "description": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "at",
                      "method",
                      "uri",
                      "outcome",
                      "mocked",
                      "mapping",
                      "scenario",
                      "body"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "cause": {
                  "description": "What went wrong",
                  "enum": [
                    "not on screen",
                    "timeout",
                    "app crashed",
                    "unmocked call",
                    "device error",
                    "step failed"
                  ]
                },
                "crash": {
                  "description": "The app crashed or hung during the flow: what the device log says",
                  "type": "string"
                },
                "error": {
                  "additionalProperties": false,
                  "description": "What went wrong, at which step",
                  "properties": {
                    "expected": {
                      "description": "What it takes, if that can be said",
                      "type": "string"
                    },
                    "file": {
                      "description": "Where it is written; empty if it isn't of a file",
                      "type": "string"
                    },
                    "fix": {
                      "description": "What to write instead, if that can be said",
                      "type": "string"
                    },
                    "line": {
                      "description": "0 if not known",
                      "type": "integer"
                    },
                    "message": {
                      "description": "What is wrong",
                      "type": "string"
                    },
                    "nearest": {
                      "description": "Of that, the closest to what is written",
                      "type": "string"
                    },
                    "step": {
                      "description": "Of a flow that failed, the step",
                      "type": "string"
                    }
                  },
                  "required": [
                    "file",
                    "line",
                    "step",
                    "message",
                    "expected",
                    "nearest",
                    "fix"
                  ],
                  "type": "object"
                },
                "from": {
                  "description": "The step that ran that flow, and so on outwards",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "description": "",
                        "type": "string"
                      },
                      "line": {
                        "description": "",
                        "type": "integer"
                      },
                      "step": {
                        "description": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "step",
                      "file",
                      "line"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "nearest": {
                  "description": "Of 'not on screen', the elements on it most like what was looked for",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "saved": {
                  "description": "The first file of the rest, which are named alike",
                  "type": "string"
                },
                "scenarios": {
                  "description": "Of the mocks, the state each was in as it failed; empty without scenarios",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "description": "Its scenarioName",
                        "type": "string"
                      },
                      "state": {
                        "description": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "state"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "screen": {
                  "description": "The elements on it",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "trail": {
                  "description": "The scenarios as each step began, the last 2000 steps: what --resume and --from set",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "The step, file:line",
                        "type": "string"
                      },
                      "scenarios": {
                        "description": "",
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "description": "Its scenarioName",
                              "type": "string"
                            },
                            "state": {
                              "description": "",
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "state"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "at",
                      "scenarios"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "try": {
                  "description": "From 1",
                  "type": "integer"
                },
                "verdict": {
                  "description": "In a line: '<flow> failed at <step>: <cause>'; of 'step failed', then the first line of why and (<file>:<line>); 'failed before its first step' or 'failed outside a step' if it isn't of a step",
                  "type": "string"
                }
              },
              "required": [
                "try",
                "verdict",
                "cause",
                "error",
                "blame",
                "because",
                "from",
                "before",
                "nearest",
                "calls",
                "screen",
                "crash",
                "saved",
                "scenarios",
                "trail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "file": {
            "description": "The flow's",
            "type": "string"
          },
          "name": {
            "description": "The flow's",
            "type": "string"
          },
          "notRunReason": {
            "description": "If it is NOT_RUN",
            "type": "string"
          },
          "recordings": {
            "description": "Videos",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "retries": {
            "description": "Those allowed",
            "type": "integer"
          },
          "seconds": {
            "description": "All its tries",
            "type": "number"
          },
          "status": {
            "description": "One of the outcomes",
            "enum": [
              "PASS",
              "FLAKY",
              "FAIL",
              "INTERRUPTED",
              "NOT_RUN"
            ]
          },
          "step": {
            "description": "Of its last try that failed, the step that failed",
            "type": "string"
          },
          "timesFailed": {
            "description": "Of those",
            "type": "integer"
          },
          "tries": {
            "description": "Those it took",
            "type": "integer"
          },
          "warnings": {
            "description": "What may explain this, or the next flow",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "why": {
            "description": "What went wrong in that try",
            "type": "string"
          }
        },
        "required": [
          "name",
          "file",
          "status",
          "blame",
          "began",
          "seconds",
          "attempts",
          "step",
          "at",
          "why",
          "tries",
          "timesFailed",
          "retries",
          "notRunReason",
          "warnings",
          "recordings",
          "failures"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "description": "Nothing failed, was interrupted or didn't run, nor was flaky with flaky-fails-build: as the exit code",
      "type": "boolean"
    },
    "order": {
      "description": "--shuffle=<seed>, if shuffled",
      "type": "string"
    },
    "run": {
      "description": "The suite's name, or what was run",
      "type": "string"
    },
    "schemaVersion": {
      "description": "Changes if the meaning of a key does",
      "type": "integer"
    },
    "stopped": {
      "description": "Why, if it stopped before the end",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "description": "The run at a glance, see below",
      "properties": {
        "began": {
          "description": "In UTC",
          "type": "string"
        },
        "exit": {
          "additionalProperties": false,
          "description": "The exit code of the run",
          "properties": {
            "code": {
              "description": "",
              "type": "integer"
            },
            "name": {
              "description": "Such as failed",
              "type": "string"
            }
          },
          "required": [
            "code",
            "name"
          ],
          "type": "object"
        },
        "failed": {
          "description": "",
          "type": "integer"
        },
        "failedFlows": {
          "description": "The names of those that failed, were interrupted or didn't run",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "flaky": {
          "description": "Failed, then passed on a retry",
          "type": "integer"
        },
        "flakyFlows": {
          "description": "The names of those that were flaky",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "interrupted": {
          "description": "",
          "type": "integer"
        },
        "notRun": {
          "description": "",
          "type": "integer"
        },
        "passed": {
          "description": "At the first try",
          "type": "integer"
        },
        "retried": {
          "description": "Flows tried more than once, whether they passed or not",
          "type": "integer"
        },
        "seconds": {
          "description": "All of it",
          "type": "number"
        },
        "slowest": {
          "description": "The flows that took longest, as many as slowest says",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "",
                "type": "string"
              },
              "seconds": {
                "description": "",
                "type": "number"
              }
            },
            "required": [
              "name",
              "seconds"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "total": {
          "description": "Flows",
          "type": "integer"
        }
      },
      "required": [
        "began",
        "seconds",
        "total",
        "passed",
        "flaky",
        "failed",
        "interrupted",
        "notRun",
        "retried",
        "failedFlows",
        "flakyFlows",
        "slowest",
        "exit"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "run",
    "device",
    "order",
    "stopped",
    "ok",
    "summary",
    "flows"
  ],
  "title": "Results of rayo",
  "type": "object"
}
