{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "description": "Installed before the flows",
      "properties": {
        "apk": {
          "description": "What to install, if the device has another. rayo doesn't build it (required)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "id": {
          "description": "The app's (required)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "id",
        "apk"
      ],
      "type": "object"
    },
    "ca": {
      "description": "--ca overrides it: the CA the proxy signs with, its ca.pem and ca-key.pem, relative to the suite; rayo ca new makes one (default: .rayo/ca next to the suite or above it, up to the repository's root; else ~/.rayo)",
      "type": "string"
    },
    "capture": {
      "additionalProperties": false,
      "description": "How a capture calls the backend and becomes mocks, as the options of the same names, which win",
      "properties": {
        "captureHeaders": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --capture-headers"
        },
        "from": {
          "description": "As --capture-from",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "graphql": {
          "description": "As --graphql",
          "enum": [
            "operation+variables",
            "operation",
            "off"
          ]
        },
        "graphqlPath": {
          "description": "As --graphql-path",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "hosts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --hosts"
        },
        "ignoreBody": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --ignore-body"
        },
        "ignoreHost": {
          "description": "As --ignore-host",
          "type": "boolean"
        },
        "ignoreParams": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --ignore-params"
        },
        "ignorePathIds": {
          "description": "As --ignore-path-ids",
          "type": "boolean"
        },
        "redactValue": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "As --redact-value: what a private field of a body becomes, such as phone: \"+4915100000000\"",
          "type": "object"
        },
        "rest": {
          "description": "As --rest",
          "enum": [
            "body",
            "off"
          ]
        },
        "stateless": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --stateless"
        },
        "timestamps": {
          "description": "As --timestamps",
          "enum": [
            "format",
            "exact"
          ]
        }
      },
      "type": "object"
    },
    "detail": {
      "description": "--detail overrides it: how much is printed (default: normal)",
      "enum": [
        "brief",
        "normal",
        "full"
      ]
    },
    "device": {
      "additionalProperties": false,
      "description": "How it is while the flows run",
      "properties": {
        "darkMode": {
          "description": "The dark theme",
          "type": "boolean"
        },
        "dpi": {
          "description": "Its density. With size, it says how many dp there are: 1080 pixels at 420 dpi are 411 dp",
          "maximum": 1000,
          "minimum": 72,
          "type": "integer"
        },
        "fontScale": {
          "description": "Of the text; 1 is normal",
          "maximum": 3,
          "minimum": 0.5,
          "type": "number"
        },
        "size": {
          "description": "Of the screen",
          "pattern": "^[1-9]\\d{2,3}x[1-9]\\d{2,3}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "env": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Variables for every flow, over a flow's own env; -e overrides one; they may use ${...}, such as ${rayo.file}",
      "type": "object"
    },
    "failureWindow": {
      "description": "--failure-window overrides it: a failure's log and calls begin this long before the failing step (default: 10)",
      "minimum": 1,
      "type": "integer"
    },
    "flakyFailsBuild": {
      "description": "--flaky-fails-build too: a run where every flow passed, some only on a retry, exits 4 (default: false: it exits 0)",
      "type": "boolean"
    },
    "flows": {
      "description": "Files, run in this order; or mappings with file, retries, mock, network, unmocked and capture (required)",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "capture": {
                "additionalProperties": false,
                "description": "How a capture calls the backend and becomes mocks, as the options of the same names, which win (default: the suite's; what it says wins over it)",
                "properties": {
                  "captureHeaders": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --capture-headers"
                  },
                  "from": {
                    "description": "As --capture-from",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "graphql": {
                    "description": "As --graphql",
                    "enum": [
                      "operation+variables",
                      "operation",
                      "off"
                    ]
                  },
                  "graphqlPath": {
                    "description": "As --graphql-path",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "hosts": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --hosts"
                  },
                  "ignoreBody": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --ignore-body"
                  },
                  "ignoreHost": {
                    "description": "As --ignore-host",
                    "type": "boolean"
                  },
                  "ignoreParams": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --ignore-params"
                  },
                  "ignorePathIds": {
                    "description": "As --ignore-path-ids",
                    "type": "boolean"
                  },
                  "redactValue": {
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "description": "As --redact-value: what a private field of a body becomes, such as phone: \"+4915100000000\"",
                    "type": "object"
                  },
                  "rest": {
                    "description": "As --rest",
                    "enum": [
                      "body",
                      "off"
                    ]
                  },
                  "stateless": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --stateless"
                  },
                  "timestamps": {
                    "description": "As --timestamps",
                    "enum": [
                      "format",
                      "exact"
                    ]
                  }
                },
                "type": "object"
              },
              "file": {
                "description": "The flow (required)",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "mock": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ],
                "description": "Who answers as the backend, as a flow's mock, relative to the suite; the flow's own mock wins"
              },
              "network": {
                "description": "How the app's calls reach the mock, as a flow's network; the flow's own and --network override it (default: the suite's)",
                "enum": [
                  "interceptor",
                  "proxy"
                ]
              },
              "retries": {
                "description": "How many times it is tried again if it fails (default: the suite's)",
                "minimum": 0,
                "type": "integer"
              },
              "unmocked": {
                "additionalProperties": false,
                "description": "Calls without a mock that don't fail the flow (default: the suite's; its calls are added to them)",
                "properties": {
                  "body": {
                    "description": "Of the answer (default: not mocked:  and the call)",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "ignore": {
                    "description": "Calls that no mock answers but that don't fail the flow: each graphql:Operation, host/path, host or /path, as --ignore-unmocked, or a mapping with host, path and graphql (required)",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "graphql": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "items": {
                                    "type": "string"
                                  },
                                  "type": "array"
                                }
                              ],
                              "description": "GraphQL operations (default: any call)"
                            },
                            "host": {
                              "description": "Of the call, or of its subdomains (default: any)",
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            },
                            "path": {
                              "description": "Of the call, without the host; * is any text but /, ** any (default: any)",
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          "type": "object"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  "status": {
                    "description": "What those calls are answered with (default: 404)",
                    "maximum": 599,
                    "minimum": 100,
                    "type": "integer"
                  }
                },
                "required": [
                  "ignore"
                ],
                "type": "object"
              }
            },
            "required": [
              "file"
            ],
            "type": "object"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "format": {
      "description": "What is printed; --format overrides it (default: human)",
      "enum": [
        "human",
        "json",
        "ndjson"
      ]
    },
    "minFlows": {
      "description": "--min-flows overrides it: fewer flows chosen, by tags, names or what changed, is an error (exit 2), not a green run of nothing (default: none)",
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "description": "Shown in the results (default: the file)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "network": {
      "description": "How the app's calls reach the mock, as a flow's network; the flow's own and --network override it (default: each flow's, else interceptor)",
      "enum": [
        "interceptor",
        "proxy"
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifacts": {
              "anyOf": [
                {
                  "enum": [
                    "video",
                    "screenshot",
                    "logcat",
                    "screen",
                    "requests"
                  ]
                },
                {
                  "items": {
                    "enum": [
                      "video",
                      "screenshot",
                      "logcat",
                      "screen",
                      "requests"
                    ]
                  },
                  "type": "array"
                }
              ],
              "description": "The kinds of file written, of video, screenshot, logcat, screen, requests; --artifacts overrides it (default: all)"
            },
            "folder": {
              "description": "Where everything goes; --output overrides it (default: .rayo where rayo runs)",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "keep": {
              "description": "The files of every try (all), only of the tries that failed (failed), or none; --keep overrides it (default: all)",
              "enum": [
                "all",
                "failed",
                "none"
              ]
            },
            "nameTemplate": {
              "description": "How the files are named in the folder; --name-template overrides it (default: {flow}_{attempt}_{kind}.{ext})",
              "type": "string"
            },
            "video": {
              "description": "A video of each flow whose header doesn't say record; --video overrides it (default: false)",
              "type": "boolean"
            }
          },
          "type": "object"
        }
      ],
      "description": "What a run writes, and where: a folder, or folder, keep, video, artifacts and nameTemplate (default: .rayo where rayo runs)"
    },
    "results": {
      "anyOf": [
        {
          "pattern": "\\.(txt|json|xml|md)$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "\\.(txt|json|xml|md)$",
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "--results replaces them all: .txt, .json, .xml (JUnit) or .md"
    },
    "resultsTemplate": {
      "description": "--results-template overrides it: the results with its extension are written as it says",
      "type": "string"
    },
    "retries": {
      "description": "How many times a flow that fails is tried again (default: 1)",
      "minimum": 0,
      "type": "integer"
    },
    "show": {
      "anyOf": [
        {
          "enum": [
            "failed",
            "flaky",
            "slow",
            "all"
          ]
        },
        {
          "items": {
            "enum": [
              "failed",
              "flaky",
              "slow",
              "all"
            ]
          },
          "type": "array"
        }
      ],
      "description": "--show overrides it: the flows the results list, of failed, flaky, slow, all (default: all)"
    },
    "slowest": {
      "description": "--slowest overrides it: how many flows the slow list has (default: 5)",
      "minimum": 1,
      "type": "integer"
    },
    "timeoutScale": {
      "description": "Multiplies the default waits; --timeout-scale overrides it (default: 1)",
      "maximum": 10,
      "minimum": 0.1,
      "type": "number"
    },
    "unmocked": {
      "additionalProperties": false,
      "description": "Calls without a mock that don't fail the flow (default: none: each fails the flow)",
      "properties": {
        "body": {
          "description": "Of the answer (default: not mocked:  and the call)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "ignore": {
          "description": "Calls that no mock answers but that don't fail the flow: each graphql:Operation, host/path, host or /path, as --ignore-unmocked, or a mapping with host, path and graphql (required)",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "graphql": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "GraphQL operations (default: any call)"
                  },
                  "host": {
                    "description": "Of the call, or of its subdomains (default: any)",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "path": {
                    "description": "Of the call, without the host; * is any text but /, ** any (default: any)",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "status": {
          "description": "What those calls are answered with (default: 404)",
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "ignore"
      ],
      "type": "object"
    }
  },
  "required": [
    "flows"
  ],
  "title": "A rayo suite, *.suite.yaml",
  "type": "object"
}
