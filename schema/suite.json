{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "description": "Installed before the flows",
      "properties": {
        "apk": {
          "description": "What to install, if the device has another. rayo doesn't build it (required)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "id": {
          "description": "The app's (required)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "id",
        "apk"
      ],
      "type": "object"
    },
    "artifacts": {
      "anyOf": [
        {
          "enum": [
            "video",
            "screenshot",
            "logcat",
            "screen",
            "requests"
          ]
        },
        {
          "items": {
            "enum": [
              "video",
              "screenshot",
              "logcat",
              "screen",
              "requests"
            ]
          },
          "type": "array"
        }
      ],
      "description": "As --artifacts, which wins: the kinds of file written, of video, screenshot, logcat, screen, requests (default: all)"
    },
    "capture": {
      "additionalProperties": false,
      "description": "How a capture calls the backend and becomes mocks, as the options of the same names, which win",
      "properties": {
        "captureHeaders": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --capture-headers"
        },
        "from": {
          "description": "As --capture-from",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "graphql": {
          "description": "As --graphql",
          "enum": [
            "operation+variables",
            "operation",
            "off"
          ]
        },
        "graphqlPath": {
          "description": "As --graphql-path",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "hosts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --hosts"
        },
        "ignoreBody": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --ignore-body"
        },
        "ignoreHost": {
          "description": "As --ignore-host",
          "type": "boolean"
        },
        "ignoreParams": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --ignore-params"
        },
        "ignorePathIds": {
          "description": "As --ignore-path-ids",
          "type": "boolean"
        },
        "redactValue": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "As --redact-value: what a private field of a body becomes, such as phone: \"+4915100000000\"",
          "type": "object"
        },
        "rest": {
          "description": "As --rest",
          "enum": [
            "body",
            "off"
          ]
        },
        "stateless": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "As --stateless"
        },
        "timestamps": {
          "description": "As --timestamps",
          "enum": [
            "format",
            "exact"
          ]
        }
      },
      "type": "object"
    },
    "device": {
      "additionalProperties": false,
      "description": "How it is while the flows run",
      "properties": {
        "darkMode": {
          "description": "The dark theme",
          "type": "boolean"
        },
        "dpi": {
          "description": "Its density. With size, it says how many dp there are: 1080 pixels at 420 dpi are 411 dp",
          "maximum": 1000,
          "minimum": 72,
          "type": "integer"
        },
        "fontScale": {
          "description": "Of the text; 1 is normal",
          "maximum": 3,
          "minimum": 0.5,
          "type": "number"
        },
        "size": {
          "description": "Of the screen",
          "pattern": "^[1-9]\\d{2,3}x[1-9]\\d{2,3}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "env": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Variables for every flow, as -e, which wins; they may use ${...}, such as ${rayo.file}",
      "type": "object"
    },
    "flows": {
      "description": "Files, run in this order; or mappings with file, retries, mock, network, unmocked and capture (required)",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "capture": {
                "additionalProperties": false,
                "description": "How a capture calls the backend and becomes mocks, as the options of the same names, which win (default: the suite's; what it says wins over it)",
                "properties": {
                  "captureHeaders": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --capture-headers"
                  },
                  "from": {
                    "description": "As --capture-from",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "graphql": {
                    "description": "As --graphql",
                    "enum": [
                      "operation+variables",
                      "operation",
                      "off"
                    ]
                  },
                  "graphqlPath": {
                    "description": "As --graphql-path",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "hosts": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --hosts"
                  },
                  "ignoreBody": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --ignore-body"
                  },
                  "ignoreHost": {
                    "description": "As --ignore-host",
                    "type": "boolean"
                  },
                  "ignoreParams": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --ignore-params"
                  },
                  "ignorePathIds": {
                    "description": "As --ignore-path-ids",
                    "type": "boolean"
                  },
                  "redactValue": {
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "description": "As --redact-value: what a private field of a body becomes, such as phone: \"+4915100000000\"",
                    "type": "object"
                  },
                  "rest": {
                    "description": "As --rest",
                    "enum": [
                      "body",
                      "off"
                    ]
                  },
                  "stateless": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "As --stateless"
                  },
                  "timestamps": {
                    "description": "As --timestamps",
                    "enum": [
                      "format",
                      "exact"
                    ]
                  }
                },
                "type": "object"
              },
              "file": {
                "description": "The flow (required)",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "mock": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ],
                "description": "Who answers as the backend, as a flow's mock, relative to the suite; the flow's own mock wins"
              },
              "network": {
                "description": "How the app's calls reach the mock, as a flow's network; the flow's own and --network win (default: the suite's)",
                "enum": [
                  "interceptor",
                  "proxy"
                ]
              },
              "retries": {
                "description": "How many times it is tried again if it fails (default: the suite's)",
                "minimum": 0,
                "type": "integer"
              },
              "unmocked": {
                "additionalProperties": false,
                "description": "Calls without a mock that don't fail the flow (default: the suite's; its calls are added to them)",
                "properties": {
                  "body": {
                    "description": "Of the answer (default: not mocked:  and the call)",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "ignore": {
                    "description": "Calls that no mock answers but that don't fail the flow: each graphql:Operation, host/path, host or /path, as --ignore-unmocked, or a mapping with host, path and graphql (required)",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "graphql": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "items": {
                                    "type": "string"
                                  },
                                  "type": "array"
                                }
                              ],
                              "description": "GraphQL operations (default: any call)"
                            },
                            "host": {
                              "description": "Of the call, or of its subdomains (default: any)",
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            },
                            "path": {
                              "description": "Of the call, without the host; * is any text but /, ** any (default: any)",
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          "type": "object"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  "status": {
                    "description": "What those calls are answered with (default: 404)",
                    "maximum": 599,
                    "minimum": 100,
                    "type": "integer"
                  }
                },
                "required": [
                  "ignore"
                ],
                "type": "object"
              }
            },
            "required": [
              "file"
            ],
            "type": "object"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "format": {
      "description": "What is printed, as --format, which wins (default: human)",
      "enum": [
        "human",
        "json",
        "ndjson"
      ]
    },
    "keep": {
      "description": "As --keep, which wins: the files of the attempts that failed, of all, or none (default: failed)",
      "enum": [
        "failed",
        "all",
        "none"
      ]
    },
    "name": {
      "description": "Shown in the results (default: the file)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "name-template": {
      "description": "As --name-template, which wins: how the files are named in output (default: {flow}_{attempt}_{kind}.{ext})",
      "type": "string"
    },
    "network": {
      "description": "How the app's calls reach the mock, as a flow's network; the flow's own and --network win (default: each flow's, else interceptor)",
      "enum": [
        "interceptor",
        "proxy"
      ]
    },
    "output": {
      "description": "As --output, which wins (default: .rayo where rayo runs)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "record": {
      "description": "A video of each flow that doesn't say (default: false)",
      "type": "boolean"
    },
    "recordFolder": {
      "description": "Where the videos go; needs record: true (default: output)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "results": {
      "anyOf": [
        {
          "pattern": "\\.(txt|json|xml)$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "\\.(txt|json|xml)$",
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "As --results, which wins over all of them: .txt, .json or .xml (JUnit)"
    },
    "retries": {
      "description": "How many times a flow that fails is tried again (default: 1)",
      "minimum": 0,
      "type": "integer"
    },
    "timeoutScale": {
      "description": "Multiplies the default waits; --timeout-scale wins (default: 1)",
      "maximum": 10,
      "minimum": 0.1,
      "type": "number"
    },
    "unmocked": {
      "additionalProperties": false,
      "description": "Calls without a mock that don't fail the flow (default: none: each fails the flow)",
      "properties": {
        "body": {
          "description": "Of the answer (default: not mocked:  and the call)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "ignore": {
          "description": "Calls that no mock answers but that don't fail the flow: each graphql:Operation, host/path, host or /path, as --ignore-unmocked, or a mapping with host, path and graphql (required)",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "graphql": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ],
                    "description": "GraphQL operations (default: any call)"
                  },
                  "host": {
                    "description": "Of the call, or of its subdomains (default: any)",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "path": {
                    "description": "Of the call, without the host; * is any text but /, ** any (default: any)",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "status": {
          "description": "What those calls are answered with (default: 404)",
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "ignore"
      ],
      "type": "object"
    }
  },
  "required": [
    "flows"
  ],
  "title": "A rayo suite, *.suite.yaml",
  "type": "object"
}
