{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "description": "Installed before the flows",
      "properties": {
        "apk": {
          "description": "What to install, if the device has another. rayo doesn't build it (required)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "id": {
          "description": "The app's (required)",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "id",
        "apk"
      ],
      "type": "object"
    },
    "device": {
      "additionalProperties": false,
      "description": "How it is while the flows run",
      "properties": {
        "darkMode": {
          "description": "The dark theme",
          "type": "boolean"
        },
        "dpi": {
          "description": "Its density. With size, it says how many dp there are: 1080 pixels at 420 dpi are 411 dp",
          "maximum": 1000,
          "minimum": 72,
          "type": "integer"
        },
        "fontScale": {
          "description": "Of the text; 1 is normal",
          "maximum": 3,
          "minimum": 0.5,
          "type": "number"
        },
        "size": {
          "description": "Of the screen",
          "pattern": "^[1-9]\\d{2,3}x[1-9]\\d{2,3}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "env": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Variables for every flow, as -e, which wins; they may use ${...}, such as ${rayo.file}",
      "type": "object"
    },
    "flows": {
      "description": "Files, run in this order; or mappings with file, retries, mock and network (required)",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "file": {
                "description": "The flow (required)",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "mock": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ],
                "description": "Who answers as the backend, as a flow's mock, relative to the suite; the flow's own mock wins"
              },
              "network": {
                "description": "How the app's calls reach the mock, as a flow's network; the flow's own and --network win (default: the suite's)",
                "enum": [
                  "interceptor",
                  "proxy"
                ]
              },
              "retries": {
                "description": "How many times it is tried again if it fails (default: the suite's)",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "file"
            ],
            "type": "object"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "name": {
      "description": "Shown in the results (default: the file)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "network": {
      "description": "How the app's calls reach the mock, as a flow's network; the flow's own and --network win (default: each flow's, else interceptor)",
      "enum": [
        "interceptor",
        "proxy"
      ]
    },
    "output": {
      "description": "As --output, which wins (default: .rayo where rayo runs)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "record": {
      "description": "A video of each flow that doesn't say (default: false)",
      "type": "boolean"
    },
    "recordFolder": {
      "description": "Where the videos go; needs record: true (default: each flow's, in output)",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "results": {
      "anyOf": [
        {
          "pattern": "\\.(txt|json|xml)$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "\\.(txt|json|xml)$",
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "As --results, which wins over all of them: .txt, .json or .xml (JUnit)"
    },
    "retries": {
      "description": "How many times a flow that fails is tried again (default: 1)",
      "minimum": 0,
      "type": "integer"
    },
    "timeoutScale": {
      "description": "Multiplies the default waits; --timeout-scale wins (default: 1)",
      "maximum": 10,
      "minimum": 0.1,
      "type": "number"
    }
  },
  "required": [
    "flows"
  ],
  "title": "A rayo suite, *.rayo.yaml",
  "type": "object"
}
